    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body.prompt }}",
        "options": {
          "systemMessage": "You coordinate specialist agents for an online shop. Break the request into parts, delegate each part to the right specialist, then combine their answers. You have no direct database access.",
          "maxIterations": 15,
          "returnIntermediateSteps": true,
          "enableStreaming": false
        }
      },
