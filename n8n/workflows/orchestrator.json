    {
      "parameters": {
        "toolDescription": "Specialist for sales, orders and products questions. Give it one clear question.",
        "text": "={{ $fromAI('task', 'The question for this specialist', 'string') }}",
        "options": {
          "systemMessage": "You are a data analyst for an online shop. You answer business questions with SQL. You work against a PostgreSQL 16 database through the tools you have. Discover the schema with the tools instead of guessing table or column names. Answer in plain language and say which tables you used.",
          "maxIterations": 10,
          "enableStreaming": false
        }
      },
      "id": "44f695c1-5422-5d25-aa0f-4c66d24f8fac",
      "name": "sales_analyst",
      "type": "@n8n/n8n-nodes-langchain.agentTool",
      "typeVersion": 3,
      "position": [
        420,
        260
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "gpt-5-mini"
        },
        "options": {}
      },
      "id": "73fe60b4-5ee4-575f-9d0c-38feeee13fb3",
      "name": "sales_analyst_model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        320,
        480
      ],
      "credentials": {
        "openAiApi": {
          "id": "labOpenAi0000001",
          "name": "OpenAI lab"
        }
      }
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "List all tables in the database with their schema and description. Takes no input.",
        "operation": "executeQuery",
        "query": "=/* run:{{ $('Webhook').first().json.body.run_id }} */ SELECT n.nspname AS schema, c.relname AS table, obj_description(c.oid) AS description FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace WHERE c.relkind IN ('r','v','p') AND n.nspname NOT IN ('pg_catalog','information_schema','pg_toast','lab','agent_memory') ORDER BY 1, 2",
        "options": {}
      },
      "id": "2b57e8da-0584-5086-ae82-de376a3ef464",
      "name": "sales_analyst_list_tables",
      "type": "n8n-nodes-base.postgresTool",
      "typeVersion": 2.6,
      "position": [
        420,
        700
      ],
      "credentials": {
        "postgres": {
          "id": "labPgAnalyst0001",
          "name": "PG agent_analyst"
        }
      }
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Show the columns (name, type, nullable, comment) of one table.",
        "operation": "executeQuery",
        "query": "=/* run:{{ $('Webhook').first().json.body.run_id }} */ SELECT a.attname AS column, format_type(a.atttypid, a.atttypmod) AS type, NOT a.attnotnull AS nullable, col_description(a.attrelid, a.attnum) AS comment FROM pg_attribute a WHERE a.attrelid = to_regclass($1 || '.' || $2) AND a.attnum > 0 AND NOT a.attisdropped ORDER BY a.attnum",
        "options": {
          "queryReplacement": "={{ $fromAI('schema_name', 'Schema of the table, e.g. sales', 'string') }},{{ $fromAI('table_name', 'Table name without schema, e.g. orders', 'string') }}"
        }
      },
      "id": "87275b88-debb-5c74-90ac-a6e6fdf4e2ba",
      "name": "sales_analyst_describe_table",
      "type": "n8n-nodes-base.postgresTool",
      "typeVersion": 2.6,
