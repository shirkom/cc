    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body.prompt }}",
        "options": {
          "systemMessage": "You are a customer support assistant for an online shop. You read support tickets, look up customers and orders, and add notes to tickets. You work against a PostgreSQL 16 database through the tools you have. Discover the schema with the tools instead of guessing table or column names. Answer in plain language and say which tables you used.",
          "maxIterations": 15,
          "returnIntermediateSteps": true,
          "enableStreaming": false
        }
      },
      "id": "7f220001-3319-5715-a080-b028eddfff84",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        260,
        0
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "respondWith": "firstIncomingItem",
        "options": {}
      },
      "id": "d598d6ee-1976-52cf-83fd-aec1601116bb",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        620,
        0
      ]
    },
    {
      "parameters": {
