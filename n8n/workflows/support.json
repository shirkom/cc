        }
      }
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "List all tables in the database with their schema and description. Takes no input.",
        "operation": "executeQuery",
        "query": "=/* run:{{ $('Webhook').first().json.body.run_id }} */ SELECT n.nspname AS schema, c.relname AS table, obj_description(c.oid) AS description FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace WHERE c.relkind IN ('r','v','p') AND n.nspname NOT IN ('pg_catalog','information_schema','pg_toast','lab','agent_memory') ORDER BY 1, 2",
        "options": {}
      },
      "id": "148845b4-cfc0-546e-b297-d90b39ed5dde",
      "name": "list_tables",
      "type": "n8n-nodes-base.postgresTool",
      "typeVersion": 2.6,
      "position": [
        380,
        260
      ],
      "credentials": {
        "postgres": {
          "id": "labPgSupport0001",
          "name": "PG agent_support"
        }
      }
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Show the columns (name, type, nullable, comment) of one table.",
        "operation": "executeQuery",
        "query": "=/* run:{{ $('Webhook').first().json.body.run_id }} */ SELECT a.attname AS column, format_type(a.atttypid, a.atttypmod) AS type, NOT a.attnotnull AS nullable, col_description(a.attrelid, a.attnum) AS comment FROM pg_attribute a WHERE a.attrelid = to_regclass($1 || '.' || $2) AND a.attnum > 0 AND NOT a.attisdropped ORDER BY a.attnum",
        "options": {
          "queryReplacement": "={{ $fromAI('schema_name', 'Schema of the table, e.g. sales', 'string') }},{{ $fromAI('table_name', 'Table name without schema, e.g. orders', 'string') }}"
        }
      },
      "id": "28152672-9420-5913-8fb0-0a0ff8f2e74a",
      "name": "describe_table",
      "type": "n8n-nodes-base.postgresTool",
